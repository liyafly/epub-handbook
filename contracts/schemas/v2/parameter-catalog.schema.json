{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EPUB CLI parameter catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commonParameters",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "commonParameters": {
      "$ref": "#/$defs/parameters"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "parameters"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "$ref": "#/$defs/parameters"
          }
        }
      }
    }
  },
  "$defs": {
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "boolean",
            "integer",
            "integer-list",
            "json-string-array"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "type": "string"
        },
        "enum": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required": {
          "type": "boolean"
        },
        "minimum": {
          "type": "integer"
        }
      }
    }
  }
}
