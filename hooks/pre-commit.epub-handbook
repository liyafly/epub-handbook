#!/bin/sh
set -eu

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
[ -n "$ROOT" ] || {
  echo "pre-commit must run inside a Git worktree" >&2
  exit 1
}
cd "$ROOT"

changed=$(git diff --cached --name-only)

git diff --check --cached
python3 scripts/validate_ai_entrypoints.py
python3 scripts/validate_skills_basic.py
python3 scripts/validate_docs_consistency.py
python3 scripts/test_epub_ai_harness.py

if printf '%s\n' "$changed" | grep -Eq '^(templates/epub-style-demo/|scripts/validate_|scripts/epub_ai_harness.py|scripts/test_epub_ai_harness.py|docs/final/)'; then
  artifact=$(sh templates/epub-style-demo/build.sh)
  scripts/validate-epub-style-demo.sh --epub "$artifact"
  scripts/validate-popup-notes.sh --epub "$artifact"
  if command -v xmllint >/dev/null 2>&1; then
    xmllint --noout \
      templates/epub-style-demo/OEBPS/package.opf \
      templates/epub-style-demo/OEBPS/nav.xhtml \
      templates/epub-style-demo/OEBPS/toc.ncx
  fi
fi
