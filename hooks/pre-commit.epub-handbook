#!/bin/sh
set -eu

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
[ -n "$ROOT" ] || {
  echo "pre-commit must run inside a Git worktree" >&2
  exit 1
}
cd "$ROOT"

changed=$(git diff --cached --name-only)

git diff --check --cached
go build ./...
go test ./internal/archguard/

if printf '%s\n' "$changed" | grep -Eq '^(templates/epub-style-demo/|docs/final/)'; then
  artifact=$(sh templates/epub-style-demo/build.sh)
  go run ./cmd/epub run epub.style.demo.maintain --input "$artifact" --json > /dev/null
  go run ./cmd/epub run epub.notes.popup.normalize --input "$artifact" --json > /dev/null
  if command -v xmllint >/dev/null 2>&1; then
    xmllint --noout \
      templates/epub-style-demo/OEBPS/package.opf \
      templates/epub-style-demo/OEBPS/nav.xhtml \
      templates/epub-style-demo/OEBPS/toc.ncx
  fi
fi
