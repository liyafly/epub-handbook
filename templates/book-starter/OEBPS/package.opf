<?xml version="1.0" encoding="UTF-8"?>
<package xmlns="http://www.idpf.org/2007/opf" version="3.0" unique-identifier="bookid"
         prefix="rendition: http://www.idpf.org/vocab/rendition/#">
  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">
    <dc:identifier id="bookid">urn:uuid:00000000-0000-4000-8000-000000000001</dc:identifier>
    <dc:title>书名（请修改）</dc:title>
    <dc:creator>作者（请修改）</dc:creator>
    <dc:language>zh-CN</dc:language>
    <meta property="dcterms:modified">2026-06-12T00:00:00Z</meta>
    <meta property="rendition:layout">reflowable</meta>
    <meta name="cover" content="cover-image"/>
    <!-- 丛书与排序名示例：取消注释并改值，写法见 docs/how-to/opf-metadata.md。
    <meta property="belongs-to-collection" id="series">丛书名</meta>
    <meta refines="#series" property="collection-type">series</meta>
    <meta refines="#series" property="group-position">1</meta>
    给 dc:title 加 id="title" 后再写：
    <meta refines="#title" property="file-as">排序用书名</meta>
    -->
  </metadata>
  <manifest>
    <item id="nav"         href="nav.xhtml"             media-type="application/xhtml+xml" properties="nav"/>
    <item id="ncx"         href="toc.ncx"               media-type="application/x-dtbncx+xml"/>
    <item id="cover-image" href="Images/cover.png"      media-type="image/png" properties="cover-image"/>
    <item id="title-page"  href="Text/00-title.xhtml"   media-type="application/xhtml+xml"/>
    <item id="copyright"   href="Text/00-copyright.xhtml" media-type="application/xhtml+xml"/>
    <item id="chapter-1"   href="Text/01-chapter.xhtml" media-type="application/xhtml+xml"/>
    <item id="css-base"    href="Styles/base.css"       media-type="text/css"/>
    <item id="css-design"  href="Styles/design.css"     media-type="text/css"/>
  </manifest>
  <spine toc="ncx">
    <itemref idref="title-page"/>
    <itemref idref="copyright"/>
    <itemref idref="chapter-1"/>
  </spine>
</package>
