      "id": "epub.package.nav.audit",
      "entrypoint": "scripts/epub_preflight_harness.py",
      "arguments": ["{artifact.path}", "--format", "json"],
      "surfaces": ["agent", "legacy-cli", "parity"]
    },
    {
      "id": "epub.layout.audit",
      "entrypoint": "scripts/epub_ai_harness.py",
      "arguments": ["{artifact.path}", "--mode", "cleanup", "--format", "json"],
      "surfaces": ["agent", "legacy-cli", "parity"]
    }
  ]
}
